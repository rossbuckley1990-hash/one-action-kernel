{
  "schemaVersion": 1,
  "objective": "Allocate every penny of a settlement total across parties with a deterministic largest-remainder distribution so no penny is created or destroyed, while preserving even splits and pence formatting",
  "approvedBy": "Self-verifying loop experiment — human-approved acceptance contract",
  "allowedPaths": [
    "src/settle.ts"
  ],
  "requirements": [
    {
      "id": "no-vanishing-penny",
      "kind": "must-change",
      "description": "Uneven splits conserve the total exactly; the remainder is distributed deterministically to the leading parties",
      "module": "src/settle.ts",
      "export": "allocate",
      "cases": [
        { "args": [100, 3], "expected": [34, 33, 33] },
        { "args": [10, 3], "expected": [4, 3, 3] },
        { "args": [1, 3], "expected": [1, 0, 0] },
        { "args": [1000000, 7], "expected": [142858, 142857, 142857, 142857, 142857, 142857, 142857] }
      ]
    },
    {
      "id": "no-created-penny",
      "kind": "must-change",
      "description": "Rounding must never over-allocate beyond the total (no penny created out of thin air)",
      "module": "src/settle.ts",
      "export": "allocate",
      "cases": [
        { "args": [7, 2], "expected": [4, 3] },
        { "args": [5, 2], "expected": [3, 2] }
      ]
    },
    {
      "id": "preserve-even-splits",
      "kind": "must-preserve",
      "description": "Even splits are unchanged",
      "module": "src/settle.ts",
      "export": "allocate",
      "cases": [
        { "args": [100, 4], "expected": [25, 25, 25, 25] },
        { "args": [100, 2], "expected": [50, 50] },
        { "args": [50, 1], "expected": [50] }
      ]
    },
    {
      "id": "preserve-formatting",
      "kind": "must-preserve",
      "description": "Pence formatting is unchanged",
      "module": "src/settle.ts",
      "export": "formatPence",
      "cases": [
        { "args": [1234], "expected": "£12.34" },
        { "args": [0], "expected": "£0.00" }
      ]
    }
  ],
  "probes": [
    {
      "id": "unchanged-formatting",
      "module": "src/settle.ts",
      "export": "formatPence",
      "inputs": [[9999], [1]]
    }
  ]
}
